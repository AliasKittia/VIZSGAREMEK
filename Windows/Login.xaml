<Window x:Class="Karbantarto.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Karbantarto.Windows"
        mc:Ignorable="d"
        Title="Login" Height="280" Width="360"
        ResizeMode="NoResize"
        Closing="CloseWindow">
    <Grid>
        <!--Grid.Background>
            <ImageBrush ImageSource="../Images/lrn.jpg" Stretch="UniformToFill"></ImageBrush>
        </Grid.Background-->
    
        <StackPanel>
        <TextBlock Text="Belépés" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,20"/>
            <StackPanel Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Felhasználó név:" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
            <TextBox Name="LoginNev" HorizontalAlignment="Center" Height="23" Width="300" TextWrapping="Wrap" Text="" VerticalAlignment="Top" TextChanged="LoginNev_TextChanged"/>

            <TextBlock Text="Jelszó" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <PasswordBox Name="Jelszo" HorizontalAlignment="Center" Height="23"  VerticalAlignment="Top" Width="300" PasswordChanged="Jelszo_PasswordChanged" Password=""/>
        </StackPanel>


        <DockPanel HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Name="Bejelentkezes" Content="Bejelentkezés" Margin="0,0,20,20" VerticalAlignment="Bottom" Width="75" Click="Bejelentkezes_Click"/>
            <Button Name="RegistryBTN" Content="Regisztráció"  Margin="0,0,0,20" VerticalAlignment="Bottom" Width="75" Click="RegistryBTN_Click"/>
        </DockPanel>
        </StackPanel>
    </Grid>
</Window>
