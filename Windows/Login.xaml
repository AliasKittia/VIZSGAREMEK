<Window x:Class="Karbantarto.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Karbantarto.Windows"
        mc:Ignorable="d"
        Title="Login" Height="320" Width="360"
        ResizeMode="NoResize"
        Closing="CloseWindow">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Foreground" Value="#82C367"/>
        </Style>
    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7D3C98" Offset="0"/>
            <GradientStop Color="#0A001F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <!--Grid.Background>
            <ImageBrush ImageSource="../Images/lrn.jpg" Stretch="UniformToFill"></ImageBrush>
        </Grid.Background-->
    
        <StackPanel>
        <TextBlock Text="Belépés" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,20"/>
            <StackPanel Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Felhasználó név:" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
            <TextBox Name="LoginNev" HorizontalAlignment="Center" Height="23" Width="300" Background="White" TextWrapping="Wrap" Text="" VerticalAlignment="Top" TextChanged="LoginNev_TextChanged"/>

            <TextBlock Text="Jelszó" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <PasswordBox Name="Jelszo" HorizontalAlignment="Center" Height="23" Background="White"  VerticalAlignment="Top" Width="300" PasswordChanged="Jelszo_PasswordChanged" Password=""/>
        </StackPanel>

        <DockPanel HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Name="Bejelentkezes" Content="Bejelentkezés" Margin="0,0,20,20" VerticalAlignment="Bottom" FontSize="13" FontFamily="Comic Sans MS" Height="30" Width="90" Click="Bejelentkezes_Click"/>
                <Button Name="RegistryBTN" Content="Regisztráció"  Margin="0,0,0,20" VerticalAlignment="Bottom" FontSize="13" FontFamily="Comic Sans MS" Height="30" Width="90" Click="RegistryBTN_Click"/>
                <Button Name="GyorsBTN" Content="Gyors belépés"  Margin="20,0,0,20" VerticalAlignment="Bottom" FontSize="13" FontFamily="Comic Sans MS" Height="30" Width="90" Click="GyorsBTN_Click"/>
        </DockPanel>
            
            
        </StackPanel>
    </Grid>
</Window>
