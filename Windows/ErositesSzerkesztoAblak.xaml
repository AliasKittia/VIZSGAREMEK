<Window x:Class="Karbantarto.Windows.ErositesSzerkesztoAblak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erősítés szerkesztése" Height="350" Width="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Név:" Margin="0,0,0,5"/>
            <TextBox Name="NevTBX" Margin="0,0,0,10"/>

            <TextBlock Text="Ritkaság:" Margin="0,0,0,5"/>
            <ComboBox Name="RitkasagCBX" Margin="0,0,0,10">
                <ComboBoxItem Content="ezüst"/>
                <ComboBoxItem Content="arany"/>
                <ComboBoxItem Content="prizmatikus"/>
            </ComboBox>

            <TextBlock Text="Hatás:" Margin="0,0,0,5"/>
            <TextBox Name="HatasTBX" Height="100" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Content="Mentés" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0" Width="80" Click="Mentes_Click"/>
    </Grid>
</Window>
