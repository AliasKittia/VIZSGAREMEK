<Window x:Class="Karbantarto.Windows.TeljesTargyModositasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teljes tárgy módosítása" Height="500" Width="400" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <StackPanel>
                <TextBlock Text="Név:" />
                <TextBox Text="{Binding Name}" />

                <TextBlock Text="Féltárgy hatás 1:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Halfitemeffect1}" />

                <TextBlock Text="Féltárgy hatás 2:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Halfitemeffect2}" />

                <TextBlock Text="Bónusz hatás:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Bonuseffect}" />

                <TextBlock Text="Bónusz hatás 1:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Bonuseffect1}" />

                <TextBlock Text="Bónusz hatás 2:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Bonuseffect2}" />

                <TextBlock Text="Aktív hatás:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding ActiveEffect}" />

                <TextBlock Text="Kép (base64 vagy URL):" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Fullitemimageblob}" />

                <Button Content="Mentés" Click="MentesBTN_Click" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
