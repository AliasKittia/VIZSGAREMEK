<Window x:Class="Karbantarto.Windows.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Karbantarto.Windows"
        mc:Ignorable="d"
        Title="Regisztráció" Height="420" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Foreground" Value="#82C367"/>
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7D3C98" Offset="0"/>
            <GradientStop Color="#0A001F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">

            <TextBlock Text="Regisztráció" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Felhasználónév:" FontSize="18"/>
            <TextBox Name="UsernameBox" Width="300" Height="25" Background="White" Margin="0,0,0,10"/>

            <TextBlock Text="Teljes név:" FontSize="18"/>
            <TextBox Name="FullNameBox" Width="300" Height="25" Background="White" Margin="0,0,0,10"/>

            <TextBlock Text="E-mail cím:" FontSize="18"/>
            <TextBox Name="EmailBox" Width="300" Height="25" Background="White" Margin="0,0,0,10"/>

            <TextBlock Text="Jelszó:" FontSize="18"/>
            <PasswordBox Name="PasswordBox" Width="300" Height="25" Background="White" Margin="0,0,0,20"/>

            <Button Name="RegisterButton"
                    Content="Regisztrálok"
                    Width="150"
                    Height="35"
                    FontFamily="Comic Sans MS"
                    FontSize="14"
                    Background="#82C367"
                    Foreground="Black"
                    Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
