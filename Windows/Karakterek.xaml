<Window x:Class="Karbantarto.Windows.Karakterek"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Karbantarto.Windows"
        mc:Ignorable="d"
        Title="Karakterek" Height="640" Width="1090">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#7D3C98"/>
            <Setter Property="BorderBrush" Value="black"/>
        </Style>

    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7D3C98" Offset="0"/>
            <GradientStop Color="#0A001F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Oldalsáv -->
        <StackPanel Grid.Column="0" Width="150" >
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#7D3C98" Offset="0"/>
                    <GradientStop Color="#0A001F" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>
            <StackPanel.Effect>
                <DropShadowEffect Color="Gray" Direction="100" ShadowDepth="5" BlurRadius="20" Opacity="1.5"/>
            </StackPanel.Effect>
            <Button Name="FoOldalBTN" Content="Főoldal" Margin="10,50,10,10" Click="FoOldalBTN_Click" />
            <Button Name="KarakterekBTN" Content="Karakterek" Margin="10" Click="KarakterekBTN_Click"/>
            <Button Name="ClassokBTN" Content="Osztályok" Margin="10" Click="ClassokBTN_Click"/>
            <Button Name="ItemekBTN" Content="Tárgyak" Margin="10" Click="ItemekBTN_Click"/>
            <Button Name="AnomaliakBTN" Content="Anomáliák" Margin="10" Click="AnomaliakBTN_Click"/>
            <Button Name="TraitekBTN" Content="Erősítések" Margin="10" Click="TraitekBTN_Click"/>
            <Button Name="CsapatTervezoBTN" Content="Csapat tervező" Margin="10" Click="CsapatTervezoBTN_Click"/>
            <Button Name="KilepesBTN" Content="Kilépés" Margin="10" Click="KilepesBTN_Click"/>
            <Image Width="120" Margin="0,40,0,0">
                <Image.Source>
                    <BitmapImage DecodePixelWidth="300" UriSource="/Images/Kittylogo.png" />
                </Image.Source>
            </Image>
        </StackPanel>


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
            <TextBlock Grid.Row="0" Margin="0,5,0,5" FontFamily="Comic Sans MS" FontSize="40" VerticalAlignment="Top" HorizontalAlignment="Center" Text="Karakterek" FontWeight="Bold"/>

                <DockPanel>
                    <TextBox FontFamily="Comic Sans MS" Name="KarakterNevKeresoTBX" Text="Karakter Neve" VerticalAlignment="Top" HorizontalAlignment="Left" Height="25" FontSize="16" Background="#D4B8E6" Width="140" Margin="10,0,0,0" TextChanged="KarakterNevKeresoTBX_TextChanged"/>

                    <ComboBox FontFamily="Comic Sans MS" Name="KarakterClassCBX" HorizontalAlignment="Right" Width="140" SelectionChanged="KarakterClassCBX_SelectionChanged" Margin="0,0,37,10" Height="25" FontSize="16"/>

                </DockPanel>

            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="KarakterListBox">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10">
                                <Border x:Name="FrontCard" Background="#7D3C98" BorderBrush="Black" BorderThickness="1" Padding="10" Width="150" Height="200" MouseDown="FrontCard_MouseDown">
                                <StackPanel>
                                    <Image Source="{Binding Characterimageblob}" Height="100" Stretch="Uniform"/>
                                        <TextBlock x:Name="CharacterNameText" Foreground="#82C367" Text="{Binding CharacterName}" FontFamily="Comic Sans MS" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" TextWrapping="Wrap"/>
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
                                            <Run Text="Értéke" FontSize="15" FontFamily="Comic Sans MS"/>
                                            <Run Text=": " FontSize="15" FontFamily="Comic Sans MS"/>
                                            <Run Text="{Binding Cost}" FontSize="15" FontFamily="Comic Sans MS"/>
                                        </TextBlock>
                                    </StackPanel>
                            </Border>

                                <Border x:Name="BackCard" Background="#7D3C98" BorderBrush="Black" BorderThickness="2" Padding="10" Width="150" Height="300" Visibility="Collapsed" MouseDown="BackCard_MouseDown">
                                    <DockPanel>
                                        <Image Source="{Binding Characterimageblob}" Height="100" Stretch="Uniform"/>
                                        <StackPanel >

                                            <TextBlock  Text="{Binding CharacterName}" FontFamily="Comic Sans MS" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18"/>
                                            <TextBlock FontFamily="Comic Sans MS"  HorizontalAlignment="Center">
                                                <Run Text="Értéke:" FontSize="14" />
                                                <Run Text="{Binding Cost}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </TextBlock>

                                            <TextBlock  Text="Képesség: " FontFamily="Comic Sans MS" FontWeight="Bold" Foreground="#82C367" FontSize="14"/>
                                            <TextBlock  Text="{Binding AbilityName}" FontFamily="Comic Sans MS" FontSize="14" />
                                            <TextBlock Text="{Binding Ability}" FontFamily="Comic Sans MS" TextWrapping="Wrap" FontSize="13"/>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Életerő 1. szinten: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding Health}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Életerő 2. szinten: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding Health1}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Életerő 3. szinten: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding Health2}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Támadási sebesség: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding AttackSpeed}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Sebzés 1. szinten: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding Damage}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Sebzés 2. szinten: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding Damage1}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Sebzés 3. szinten: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding Damage2}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Varázserő: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding AbilityPower}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Kezdő mana: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding ManaStart}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Maximális mana: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding ManaMax}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Páncél: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding Armor}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Varázsellenállás: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding MagicResist}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>

                                            <DockPanel>
                                                <TextBlock FontWeight="Bold" Text="Hatótávolság: " FontFamily="Comic Sans MS" Foreground="#82C367" FontSize="14"/>
                                                <TextBlock Text="{Binding Range}" FontFamily="Comic Sans MS" FontSize="13"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
