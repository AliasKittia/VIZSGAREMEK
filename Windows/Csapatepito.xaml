<Window x:Class="Karbantarto.Windows.Csapatepito"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Karbantarto.Windows"
        mc:Ignorable="d"
        Title="Csapatepito" Height="550" Width="1090">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#7D3C98"/>
            <Setter Property="BorderBrush" Value="black"/>
        </Style>

    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7D3C98" Offset="0"/>
            <GradientStop Color="#0A001F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.RowSpan="3" Width="150">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#7D3C98" Offset="0"/>
                    <GradientStop Color="#0A001F" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>
            <StackPanel.Effect>
                <DropShadowEffect Color="Gray" Direction="100" ShadowDepth="5" BlurRadius="20" Opacity="1.5"/>
            </StackPanel.Effect>
            <Button Name="FoOldalBTN" Content="Főoldal" Margin="10,20,10,10" Click="FoOldalBTN_Click"/>
            <Button Name="KarakterekBTN" Content="Karakterek" Margin="10" Click="KarakterekBTN_Click"/>
            <Button Name="ClassokBTN" Content="Osztályok" Margin="10" Click="ClassokBTN_Click"/>
            <Button Name="ItemekBTN" Content="Tárgyak" Margin="10" Click="ItemekBTN_Click"/>
            <Button Name="AnomaliakBTN" Content="Anomáliák" Margin="10" Click="AnomaliakBTN_Click"/>
            <Button Name="TraitekBTN" Content="Erősítések" Margin="10" Click="TraitekBTN_Click"/>
            <Button Name="CsapatTervezoBTN" Content="Csapat tervező" Margin="10" Click="CsapatTervezoBTN_Click"/>
            <Button Name="KilepesBTN" Content="Kilépés" Margin="10" Click="KilepesBTN_Click"/>
            <Image Width="120" Margin="0,10,0,0">
                <Image.Source>
                    <BitmapImage DecodePixelWidth="300" UriSource="/Images/Kittylogo.png" />
                </Image.Source>
            </Image>
        </StackPanel>

        <TextBlock Text="Csapat építő:" Grid.Row="0" Grid.Column="1" Margin="0,0,0,20" FontFamily="Comic Sans MS" FontSize="40" VerticalAlignment="Top" HorizontalAlignment="Center"  FontWeight="Bold" />



        <!-- Hexagonal Grid -->
        <Border BorderBrush="Black" BorderThickness="0" Grid.Column="1">
            <Canvas Name="HexGridCanvas" Margin="70,100,0,0" />
        </Border>

        <Border BorderBrush="Black" Background="#7D3C98" BorderThickness="2" Padding="10" Grid.Row="2" Grid.Column="1" VerticalAlignment="Stretch">
            <StackPanel>
                <!-- A StackPanel tartalma ide kerülhet -->
            </StackPanel>
        </Border>
    </Grid>
</Window>
