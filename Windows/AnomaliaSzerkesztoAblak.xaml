<Window x:Class="Karbantarto.Windows.AnomaliaSzerkesztoAblak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anomália szerkesztése" Height="300" Width="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Anomália neve:" Margin="0,0,0,5"/>
            <TextBox Name="NevTBX" Margin="0,0,0,10"/>

            <TextBlock Text="Anomália hatás:" Margin="0,0,0,5"/>
            <TextBox Name="HatasTBX" Height="100" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Content="Mentés" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0" Width="80" Click="Mentes_Click"/>
    </Grid>
</Window>
