<Window x:Class="Karbantarto.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Karbantarto"
        mc:Ignorable="d"
        x:Name="fomenu"
        Title="Karbantartó rendszer" Height="700" Width="1090">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#7D3C98"/>
            <Setter Property="BorderBrush" Value="black"/>
        </Style>

    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7D3C98" Offset="0"/>
            <GradientStop Color="#0A001F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Oldalsáv -->
            <ColumnDefinition Width="*"/>
            <!-- Tartalom -->
        </Grid.ColumnDefinitions>

        <!-- Oldalsáv -->

        <StackPanel Grid.Column="0" Width="150" >
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#7D3C98" Offset="0"/>
                    <GradientStop Color="#0A001F" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>
            <StackPanel.Effect>
                <DropShadowEffect Color="Gray" Direction="100" ShadowDepth="5" BlurRadius="20" Opacity="1.5"/>
            </StackPanel.Effect>
            <Button Name="FoOldalBTN" Content="Főoldal" Margin="10,50,10,20" Click="FoOldalBTN_Click" Height="30" FontSize="17" FontWeight="Bold"/>
            <Button Name="KarakterekBTN" Content="Karakterek" Margin="10,10,10,20" Click="KarakterekBTN_Click" Height="30" FontSize="17" FontWeight="Bold"/>
            <Button Name="ClassokBTN" Content="Osztályok" Margin="10,10,10,20" Click="ClassokBTN_Click" Height="30" FontSize="17" FontWeight="Bold"/>
            <Button Name="ItemekBTN" Content="Tárgyak" Margin="10,10,10,20" Click="ItemekBTN_Click" Height="30" FontSize="17" FontWeight="Bold"/>
            <Button Name="AnomaliakBTN" Content="Anomáliák" Margin="10,10,10,20" Click="AnomaliakBTN_Click" Height="30" FontSize="17" FontWeight="Bold"/>
            <Button Name="TraitekBTN" Content="Erősítések" Margin="10,10,10,20" Click="TraitekBTN_Click" Height="30" FontSize="17" FontWeight="Bold"/>
            <Button Name="CsapatTervezoBTN" Content="Csapat tervező" Margin="10,10,10,20" Click="CsapatTervezoBTN_Click" Height="30" FontSize="17" FontWeight="Bold"/>
            <Button Name="KilepesBTN" Content="Kilépés" Margin="10,10,10,20" Click="KilepesBTN_Click" Height="30" FontSize="17" FontWeight="Bold"/>
            <Image Width="120" Margin="0,0,0,0">
                <Image.Source>
                    <BitmapImage DecodePixelWidth="300" UriSource="/Images/Kittylogo.png" />
                </Image.Source>
            </Image>
        </StackPanel>

        <DockPanel  Grid.Column="1" VerticalAlignment="Top" Margin="0,40,0,0" HorizontalAlignment="Center">
            <StackPanel>
                
                <TextBlock Name="FooldalUdvozloTBX" Foreground="#82C367" FontFamily="Comic Sans MS"  Text="Üdvözlünk az alkalmazásban!" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20"/>
                
                <TextBlock Name="FooldalSzovegTBX" FontSize="20" Foreground="#82C367" HorizontalAlignment="Center" FontFamily="Comic Sans MS" Text="Állítsd össze a legerősebb csapatot, stratégiázz okosan, és válj a legjobbá! "/>
                
                <Image Width="870" Margin="0,10,0,0">
                    <Image.Source>
                        <BitmapImage DecodePixelWidth="870" UriSource="/Images/TFTpic.png" />
                    </Image.Source>
                </Image>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
